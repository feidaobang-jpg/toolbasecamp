# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Secrets & local env
.env
.env.*
!.env.example

# Logs & runtime
*.log
server.log
server.log.bak
server/DEPLOY_SHA

# Fun Music temp audio
server/tmp_music/

# Local classic MP3 library (upload via deploy/seed-traditional-music.py)
music/
deploy/.traditional-out/
deploy/.traditional-build-state.json

# Instruct-edit result cache (runtime)
server/var/

# OS / editor
.DS_Store
Thumbs.db
*.swp
*.tmp

# Ladder scrape cache (generated by admin refresh)
server/data/ladder/*.html
server/data/ladder/meta.json

# Future frontend build output (if added)
node_modules/
dist/
build/

# Home ComfyUI API runtime output (local GPU machine)
comfyui-api-server/output/
comfyui-api-server/data/
comfyui-api-server/__pycache__/

# CodeGraph local index
.codegraph/

# NAS downloaded translation models and local migration backups
/deploy/home-nas/lt-models/
/deploy/home-nas/migration-backup/

# WorkBuddy workspace data (local memory / notes, not for version control)
.workbuddy/

# Game QA intermediate artifacts (screenshots / screencast frames / perf json)
game-projects/*/qa/render-results/

# Game media (gameplay captures, recordings, video covers/frames, audio) stay on the local disk only.
# Commit game code & resources (public/html/game/) plus media-kit / video text notes, json and scripts.
game-projects/*/media-kit/**/*.png
game-projects/*/media-kit/**/*.jpg
game-projects/*/media-kit/**/*.jpeg
game-projects/*/media-kit/**/*.webp
game-projects/*/media-kit/**/*.gif
game-projects/*/media-kit/**/*.webm
game-projects/*/media-kit/**/*.mp4
game-projects/*/media-kit/**/*.mkv
game-projects/*/media-kit/**/*.mov
game-projects/*/media-kit/**/*.wav
game-projects/*/media-kit/**/*.mp3
game-projects/*/media-kit/**/*.m4a
game-projects/*/media-kit/**/*.flac
game-projects/*/video/**/*.png
game-projects/*/video/**/*.jpg
game-projects/*/video/**/*.jpeg
game-projects/*/video/**/*.webp
game-projects/*/video/**/*.gif
game-projects/*/video/**/*.webm
game-projects/*/video/**/*.mp4
game-projects/*/video/**/*.mkv
game-projects/*/video/**/*.mov
game-projects/*/video/**/*.wav
