# Copy to local.env and fill in (local.env is gitignored).
# System env (setx) also works; values here override for this server process.
DEEPSEEK_API_KEY=

# Official ComfyUI-main folder (for scripts/run-comfyui-autostart.bat)
COMFYUI_MAIN_DIR=D:\sd\ComfyUI-main

# --- Shared desktop resource caps (optional) ---
# 0 = 完全不限制（CPU 亲和/优先级/GPU 功耗都不动）。1 = 启用下面各项。
COMFYUI_RESOURCE_LIMIT=0
# Use ~75% of logical CPU cores + lower scheduler priority (below_normal | idle | normal)
COMFYUI_RESOURCE_CPU_PERCENT=100
COMFYUI_PROCESS_PRIORITY=normal
# Optional: cap NVIDIA GPU power (% of max TDP). Requires nvidia-smi + admin. 0 = off.
COMFYUI_RESOURCE_GPU_POWER_PERCENT=0
# 成片时临时拉满 GPU 功耗（仅当上面日常有功耗上限时才有意义）。1=开，0=关。
COMFYUI_VIDEO_FULL_GPU_POWER=1
# Only one ComfyUI generation at a time (queue the rest in API)
COMFYUI_MAX_CONCURRENT_JOBS=1
# Wan 14B GGUF 单镜可能 15–30+ 分钟；默认 1 小时
COMFYUI_VIDEO_JOB_TIMEOUT=3600
# Extra args when using scripts/start-comfyui-limited.ps1 (e.g. --lowvram)
# COMFYUI_EXTRA_ARGS=
