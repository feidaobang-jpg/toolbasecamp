# Copy to local.env and fill in (local.env is gitignored).
# System env (setx) also works; values here override for this server process.
DEEPSEEK_API_KEY=

# --- Shared desktop: keep ~10% CPU/GPU headroom while ComfyUI runs in background ---
# Set COMFYUI_RESOURCE_LIMIT=0 to disable all caps.
COMFYUI_RESOURCE_LIMIT=1
# Use ~90% of logical CPU cores + lower scheduler priority (below_normal | idle | normal)
COMFYUI_RESOURCE_CPU_PERCENT=90
COMFYUI_PROCESS_PRIORITY=below_normal
# Optional: cap NVIDIA GPU power (~90% of max TDP). Requires nvidia-smi. 0 = off.
COMFYUI_RESOURCE_GPU_POWER_PERCENT=90
# Only one ComfyUI generation at a time (queue the rest in API)
COMFYUI_MAX_CONCURRENT_JOBS=1
# Extra args when using scripts/start-comfyui-limited.ps1 (e.g. --lowvram)
# COMFYUI_EXTRA_ARGS=
