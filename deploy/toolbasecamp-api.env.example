# Copy relevant lines to /etc/toolbasecamp-api.env on the VPS, then:
#   systemctl restart toolbasecamp-api
# Verify: curl -s http://127.0.0.1:8001/health

# --- DeepSeek (recipe text generation + news crawler) ---
DEEPSEEK_API_KEY=sk-xxxxxxxx
DEEPSEEK_MODEL=deepseek-chat
# News portal (news.zhengxiaohui.cn) reuses this key via /opt/toolbasecamp-news/run_news.sh
# Optional overrides: /etc/toolbasecamp-news.env (NEWS_ITEMS_PER_FEED, NEWS_WEB_ROOT, …)

# --- DashScope / 百炼华北2（北京）：识图、图生图、图生视频共用同一 DASHSCOPE_API_KEY ---
DASHSCOPE_API_KEY=sk-xxxxxxxx
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
IMAGE_EDIT_DASHSCOPE_API_URL=https://dashscope.aliyuncs.com/api/v1
QWEN_VL_MODEL=qwen3-vl-plus
WAN_IMAGE_EDIT_MODEL=wan2.6-image
WAN_I2V_MODEL=wan2.7-i2v-2026-04-25
# Billed from AI wallet: ¥0.6/s 720P · ¥1/s 1080P × AI_PRICE_MARKUP (default 2)
# Instruct-edit DashScope wait (seconds). Multi-ref / 2K uses at least PRO timeout.
# QWEN_IMAGE_EDIT_TIMEOUT=360
# QWEN_IMAGE_EDIT_PRO_TIMEOUT=600
# Optional durable dir for /api/image/tmp (default: <api>/var/image-results)
# IMAGE_TMP_DIR=/var/lib/toolbasecamp/image-results

# --- Volcengine Ark / 豆包 Seedream（指令改图可选模型）---
# Console: https://console.volcengine.com/ark → API Key
# Models: doubao-seedream-5-0-260128 (Lite)
VOLC_ARK_API_KEY=ark-xxxxxxxx
# VOLC_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# SEEDREAM_IMAGE_MODEL=doubao-seedream-5-0-260128
# SEEDREAM_IMAGE_SIZE=2K
# SEEDREAM_IMAGE_TIMEOUT=180

# --- MiniMax Music（AI 音乐）---
# Console: https://platform.minimaxi.com/user-center/basic-information/interface-key
# Docs: https://platform.minimaxi.com/docs/api-reference/music-generation
MINIMAX_API_KEY=xxxxxxxx
# MINIMAX_MUSIC_API_URL=https://api.minimaxi.com/v1/music_generation
# MINIMAX_MUSIC_MODEL=suno-v4.5
# MINIMAX_MUSIC_TIMEOUT=360

# --- 逍遥 AI / lk888（文生图 + 图生图）---
# gpt-image-2 / tt-image-2 → /v1/images/generations + /v1/images/edits
# banana-2 / banana-pro → /v1/media/generate + /v1/media/status
LK888_API_KEY=sk-xxxxxxxx
# LK888_BASE_URL=https://api.lk888.ai/v1
# LK888_IMAGE_TIMEOUT=180
# LK888_MUSIC_TIMEOUT=420
# LK888_MEDIA_POLL_INTERVAL=2
# Seedance 2.0 快档（参考生）：官方「快速」不可用时默认 Mini
# SEEDANCE20_R2V_MODEL=kwvideo-v2-ref
# SEEDANCE20_VERSION=Mini
# Also set GitHub Actions secret LK888_API_KEY so deploy upserts this on the VPS.
# MUSIC_PUBLIC_DIR=/var/lib/toolbasecamp/public-music
# TRADITIONAL_MUSIC_DIR=/var/lib/toolbasecamp/traditional-music
# TRADITIONAL_PREVIEW_BITRATE=48k
# TRADITIONAL_UPLOAD_MAX_MB=50
# (Must stay outside /opt/toolbasecamp-api — deploy rsync --delete would wipe it.)
# User price = vendor list × AI_PRICE_MARKUP: music-3.0 ¥1 → ¥2 · suno-v4.5 ≈¥0.67 → ≈¥1.34

# STATS_EXCLUDE_IPS=1.2.3.4,5.6.7.8
# Comma-separated client IPs that should not increment PV/UV/events (your home/office IP).
# Logged-in admin accounts are also skipped automatically.
# STATS_EXCLUDE_IPS=

# --- Ops: backup + alert (optional) ---
# Daily MySQL dumps: /var/backups/toolbasecamp/mysql (default retain 7 days)
# BACKUP_RETAIN_DAYS=7
# BACKUP_DIR=/var/backups/toolbasecamp/mysql
#
# Feishu custom bot webhook — alert when backup/health fails or recovers.
# Group → Apps → Custom bot → copy webhook:
# FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx
# (ALERT_WEBHOOK_URL also accepted)

# --- TianAPI 天行数据（生活模块：鸡汤/谜语/诗词等）---
# https://www.tianapi.com/
# 国内机房直连即可。默认 https://apis.tianapi.com；勿再指向旧的 tianapi 中转域名。
TIANAPI_KEY=xxxxxxxx
# TIANAPI_BASE=https://apis.tianapi.com
# TIANAPI_TIMEOUT=8

# --- Tencent Cloud (image OCR / enhance / ID photo) ---
# Console: https://console.cloud.tencent.com/cam/capi
TENCENT_SECRET_ID=AKIDxxxxxxxx
TENCENT_SECRET_KEY=xxxxxxxx
TENCENT_REGION=ap-guangzhou
# Optional daily per-user limits (defaults shown). Admin accounts are exempt.
# ADMIN_EMAIL must match your login email (same as guestbook admin), default admin@zhengxiaohui.cn
# ADMIN_EMAIL=admin@zhengxiaohui.cn
# IMAGE_LIMIT_OCR_TEXT=30
# IMAGE_LIMIT_OCR_TABLE=20
# IMAGE_LIMIT_ENHANCE=20
# IMAGE_LIMIT_ID_PHOTO=10
# IMAGE_LIMIT_GENERAL_CUTOUT=15
# IMAGE_LIMIT_INSTRUCT_EDIT=8
# IMAGE_LIMIT_TEXT_TO_IMAGE=10
# LIFE_PLAN_LIMIT=20
# DRUG_LABEL_LIMIT=10
# AI wallet: signup gift (CNY) + user charge = vendor list price × markup. Admins not charged.
# AI_BALANCE_GIFT=5
# AI_PRICE_MARKUP=2
# REFERRAL_COMMISSION_RATE=0.10
# General cutout uses rembg (optional). After deploy:
#   /opt/toolbasecamp-api/venv/bin/pip install -r /opt/toolbasecamp-api/requirements-general-cutout.txt
#   systemctl restart toolbasecamp-api
# REMBG_MODEL=u2netp

# --- Baidu 普通收录 API（资源平台 → 普通收录 → API提交；勿提交真实 token）---
# BAIDU_ZZ_SITE=https://www.zhengxiaohui.cn
# BAIDU_ZZ_TOKEN=
# Push: set -a; source /etc/toolbasecamp-api.env; set +a
#   python3 /opt/toolbasecamp-deploy/baidu-push-urls.py
