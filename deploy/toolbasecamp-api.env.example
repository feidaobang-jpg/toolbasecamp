# Copy relevant lines to /etc/toolbasecamp-api.env on the VPS, then:
#   systemctl restart toolbasecamp-api
# Verify: curl -s http://127.0.0.1:8001/health

# --- DeepSeek (recipe text generation + news crawler) ---
DEEPSEEK_API_KEY=sk-xxxxxxxx
DEEPSEEK_MODEL=deepseek-chat
# News portal (news.toolbasecamp.com) reuses this key via /opt/toolbasecamp-news/run_news.sh
# Optional overrides: /etc/toolbasecamp-news.env (NEWS_ITEMS_PER_FEED, NEWS_WEB_ROOT, …)

# --- Qwen US / DashScope (image ingredient recognition + Wan I2V) ---
DASHSCOPE_API_KEY=sk-xxxxxxxx
DASHSCOPE_BASE_URL=https://dashscope-us.aliyuncs.com/compatible-mode/v1
QWEN_VL_MODEL=qwen3-vl-plus
# Instruct image edit — US key: wan2.6-image on dashscope-us
# IMAGE_EDIT_DASHSCOPE_API_URL=https://dashscope-us.aliyuncs.com/api/v1
# QWEN_IMAGE_EDIT_MODEL=wan2.6-image
# China Beijing key instead (qwen-image-2.0; legacy qwen-image-edit retires 2026-10-10):
# IMAGE_EDIT_DASHSCOPE_API_URL=https://dashscope.aliyuncs.com/api/v1
# QWEN_IMAGE_EDIT_MODEL=qwen-image-2.0
# Wan image-to-video (uses same DASHSCOPE_API_KEY; API root derived from BASE_URL)
# US Virginia default model: wan2.6-i2v-us ; China Beijing: wan2.6-i2v-flash
# WAN_I2V_MODEL=wan2.6-i2v-us
# WAN_DASHSCOPE_API_URL=https://dashscope-us.aliyuncs.com/api/v1
# Daily free runs per login user (admins unlimited). Keep low — each run costs real money.
WAN_I2V_LIMIT=2

# STATS_EXCLUDE_IPS=1.2.3.4,5.6.7.8
# Comma-separated client IPs that should not increment PV/UV/events (your home/office IP).
# Logged-in admin accounts are also skipped automatically.
# STATS_EXCLUDE_IPS=

# --- Ops: backup + alert (optional) ---
# Daily MySQL dumps: /var/backups/toolbasecamp/mysql (default retain 7 days)
# BACKUP_RETAIN_DAYS=7
# BACKUP_DIR=/var/backups/toolbasecamp/mysql
#
# Feishu custom bot webhook — alert when backup/health fails or recovers.
# Group → Apps → Custom bot → copy webhook:
# FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx
# (ALERT_WEBHOOK_URL also accepted)

# --- TianAPI 天行数据（生活模块：鸡汤/谜语/诗词等）---
# https://www.tianapi.com/
# 国内机房直连即可。默认 https://apis.tianapi.com；勿再指向 tianapi.toolbasecamp.com 中转。
TIANAPI_KEY=xxxxxxxx
# TIANAPI_BASE=https://apis.tianapi.com
# TIANAPI_TIMEOUT=8

# --- Tencent Cloud (image OCR / enhance / ID photo) ---
# Console: https://console.cloud.tencent.com/cam/capi
TENCENT_SECRET_ID=AKIDxxxxxxxx
TENCENT_SECRET_KEY=xxxxxxxx
TENCENT_REGION=ap-guangzhou
# Optional daily per-user limits (defaults shown). Admin accounts are exempt.
# ADMIN_EMAIL must match your login email (same as guestbook admin), default admin@toolbasecamp.com
# ADMIN_EMAIL=admin@toolbasecamp.com
# IMAGE_LIMIT_OCR_TEXT=30
# IMAGE_LIMIT_OCR_TABLE=20
# IMAGE_LIMIT_ENHANCE=20
# IMAGE_LIMIT_ID_PHOTO=10
# IMAGE_LIMIT_GENERAL_CUTOUT=15
# IMAGE_LIMIT_INSTRUCT_EDIT=8
# IMAGE_LIMIT_TEXT_TO_IMAGE=10
# LIFE_PLAN_LIMIT=20
# DRUG_LABEL_LIMIT=10
# AI wallet: signup gift (CNY) + user charge = vendor list price × markup. Admins not charged.
# AI_BALANCE_GIFT=3
# AI_PRICE_MARKUP=2
# General cutout uses rembg (optional). After deploy:
#   /opt/toolbasecamp-api/venv/bin/pip install -r /opt/toolbasecamp-api/requirements-general-cutout.txt
#   systemctl restart toolbasecamp-api
# REMBG_MODEL=u2netp
