 "subs": [
  {
   "start": 0.3,
   "end": 5.048,
   "zh": "桥一断，库巴连一句狠话都没来得及说，就掉进了岩浆。",
   "en": "The bridge snaps, and Bowser drops into the lava before he can finish a single threat.",
   "shot": "01-hook"
  },
  {
   "start": 5.198,
   "end": 9.064,
   "zh": "这是超级玛丽 3D 的第四关，库巴城堡。",
   "en": "This is World 1-4 in Super Mario 3D: Bowser's Castle.",
   "shot": "01-hook"
  },
  {
   "start": 9.8,
   "end": 14.711,
   "zh": "前三关大家玩得差不多了，蓝天、地下、树冠。",
   "en": "You've already played the first three worlds - sky, cave, treetops.",
   "shot": "02-menu"
  },
  {
   "start": 156.111,
   "end": 164.099,
   "zh": "路线是在同一个世界里用深度优先搜索试出来的，三百多个节点，一百三十六段零受伤。",
   "en": "The route came out of a depth-first search inside the same world - a few hundred nodes, 136 segments, zero damage.",
   "shot": "14-honest"
  },
  {
   "start": 164.849,
   "end": 171.548,
   "zh": "下一期要么继续往后做，要么按你们的投票来，投票页和试玩链接都在简介第一条。",
   "en": "Next episode either keeps pushing forward or follows your votes - the voting page and the play link are the first lines of the description.",
   "shot": "15-next"
  },
  {
   "start": 171.698,
