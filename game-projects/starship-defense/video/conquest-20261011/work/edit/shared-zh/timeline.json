      "text": "and you can still lose.",
      "segment": "03-tickets"
    },
    {
      "start": 22.995,
      "end": 24.2275,
      "text": "If you like this mode,",
      "segment": "03-tickets"
    },
    {
      "start": 24.432499999999997,
