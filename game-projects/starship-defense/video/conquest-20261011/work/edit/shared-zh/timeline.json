    },
    {
      "start": 47.34083333333333,
      "end": 50.59833333333333,
      "text": "Select our captured depot instead of running from HQ,",
      "segment": "06-spawn"
    },
    {
      "start": 50.75333333333333,
      "end": 51.87333333333333,
      "text": "switch to Medic,",
      "segment": "06-spawn"
    },
    {
      "start": 51.97833333333333,
      "end": 53.06083333333333,
      "text": "and redeploy near the front.",
