    {
      "start": 7.386666666666667,
      "end": 9.581666666666667,
      "text": "This is the Battlefield mode in Swarm Siege.",
      "segment": "02-map"
    },
    {
      "start": 10.086666666666666,
      "end": 12.681666666666668,
      "text": "Old Town, Comms Station and Supply Depot:",
