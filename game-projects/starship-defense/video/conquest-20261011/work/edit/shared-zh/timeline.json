      "segment": "09-finish"
    },
    {
      "start": 83.02,
      "end": 85.9525,
      "text": "结算挺有意思：我方击杀九十四，",
      "segment": "10-result"
    },
    {
      "start": 86.2075,
      "end": 87.3025,
      "text": "对面一百零五。",
      "segment": "10-result"
    },
    {
      "start": 87.8075,
      "end": 89.08999999999999,
      "text": "杀得更多的一边，",
      "segment": "10-result"
    },
    {
      "start": 89.32000000000001,
      "end": 90.19,
      "text": "反而输了。",
      "segment": "10-result"
    },
    {
      "start": 90.6825,
      "end": 92.10249999999999,
      "text": "抢点和保住自己，",
      "segment": "10-result"
    },
    {
      "start": 92.3325,
      "end": 93.22749999999999,
      "text": "都得算进去。",
      "segment": "10-result"
    },
    {
      "start": 94.48666666666666,
      "end": 96.25666666666666,
      "text": "这一局靠占点赢下来了，",
      "segment": "11-close"
    },
    {
      "start": 96.59916666666668,
      "end": 98.56916666666666,
      "text": "正面硬冲还是很容易倒。",
      "segment": "11-close"
    },
    {
      "start": 99.07416666666667,
      "end": 102.05666666666666,
      "text": "下次我想试试兵种配合和侧翼夺点。",
      "segment": "11-close"
    },
    {
      "start": 102.56166666666667,
      "end": 105.23166666666667,
      "text": "虫潮围城现在可以在百宝箱试玩，",
      "segment": "11-close"
    },
    {
      "start": 105.51166666666667,
      "end": 107.50666666666666,
      "text": "想玩什么也可以填愿望单。",
      "segment": "11-close"
