    },
    {
      "start": 5.8075,
      "end": 7.3525,
      "text": "I want to search for supplies",
      "segment": "01-hook"
    },
    {
      "start": 7.495,
      "end": 8.8025,
      "text": "while finding a route out.",
      "segment": "01-hook"
    },
    {
      "start": 10.086666666666666,
      "end": 11.419166666666667,
      "text": "This time, I am leaving base defense behind.",
      "segment": "02-route"
    },
    {
      "start": 11.911666666666667,
      "end": 14.519166666666667,
      "text": "You can freely explore the abandoned town streets",
      "segment": "02-route"
    },
    {
      "start": 14.724166666666665,
      "end": 16.319166666666668,
      "text": "and choose among six infected districts.",
      "segment": "02-route"
    },
    {
      "start": 16.799166666666665,
      "end": 17.919166666666666,
      "text": "First, I drive to a garage",
      "segment": "02-route"
    },
    {
      "start": 18.124166666666667,
      "end": 19.556666666666665,
      "text": "and upgrade the roof-mounted machine gun.",
      "segment": "02-route"
    },
    {
      "start": 20.820000000000004,
      "end": 22.302500000000002,
      "text": "The upgrade costs 90 scrap",
      "segment": "03-prepare"
    },
    {
      "start": 22.507500000000004,
      "end": 23.815,
      "text": "and takes five seconds while parked.",
      "segment": "03-prepare"
    },
    {
      "start": 24.3075,
      "end": 25.965000000000003,
      "text": "Then I fill the tank at a gas station",
      "segment": "03-prepare"
    },
    {
      "start": 26.270000000000003,
      "end": 28.102500000000003,
      "text": "before heading into an infected district.",
      "segment": "03-prepare"
    },
    {
      "start": 29.353333333333335,
      "end": 30.710833333333333,
      "text": "I turn into the old residential district.",
      "segment": "04-homes"
    },
    {
      "start": 30.978333333333335,
      "end": 33.223333333333336,
      "text": "Zombies spot the RV and start chasing it.",
      "segment": "04-homes"
    },
    {
      "start": 33.72833333333333,
      "end": 35.83583333333333,
      "text": "I clear some space with the roof gun,",
      "segment": "04-homes"
    },
    {
      "start": 36.06583333333333,
      "end": 37.73583333333333,
      "text": "then get out and approach the supply crate.",
      "segment": "04-homes"
    },
    {
      "start": 37.82833333333333,
      "end": 38.748333333333335,
      "text": "Searching takes four seconds.",
      "segment": "04-homes"
    },
    {
      "start": 39.240833333333335,
      "end": 40.51083333333333,
      "text": "I find 110 scrap,",
      "segment": "04-homes"
    },
    {
      "start": 40.79083333333333,
      "end": 42.373333333333335,
      "text": "plus canned food and a medkit.",
      "segment": "04-homes"
    },
    {
      "start": 43.653333333333336,
      "end": 45.58583333333333,
      "text": "The trip is already paying for itself.",
      "segment": "05-like"
    },
    {
      "start": 46.07833333333333,
      "end": 48.19833333333334,
      "text": "If you enjoy driving out to scavenge,",
      "segment": "05-like"
    },
    {
      "start": 48.428333333333335,
      "end": 49.473333333333336,
      "text": "leave a like.",
      "segment": "05-like"
    },
    {
      "start": 50.72,
      "end": 53.44,
      "text": "The abandoned supermarket still has an emergency vending machine.",
      "segment": "06-market"
    },
    {
      "start": 53.945,
      "end": 55.652499999999996,
      "text": "I spend 12 scrap on another can of food",
      "segment": "06-market"
    },
    {
      "start": 55.919999999999995,
      "end": 57.565,
      "text": "in case I get hurt on foot.",
      "segment": "06-market"
    },
    {
      "start": 58.07,
      "end": 58.902499999999996,
      "text": "With supplies stocked,",
      "segment": "06-market"
    },
    {
      "start": 59.1075,
      "end": 60.44,
      "text": "I head to the town square.",
      "segment": "06-market"
    },
    {
      "start": 61.72,
      "end": 63.8775,
      "text": "Seven zombies chase the RV here.",
      "segment": "07-square"
    },
    {
      "start": 64.3825,
      "end": 65.76499999999999,
      "text": "The machine gun clears some room,",
      "segment": "07-square"
    },
    {
      "start": 65.995,
      "end": 67.01499999999999,
      "text": "then I get out to search.",
      "segment": "07-square"
    },
    {
      "start": 67.52,
      "end": 68.47749999999999,
      "text": "I am unhurt,",
      "segment": "07-square"
    },
    {
      "start": 68.6825,
      "end": 69.95249999999999,
      "text": "but the RV has taken damage.",
      "segment": "07-square"
    },
    {
      "start": 70.1825,
      "end": 71.4275,
      "text": "My next stop needs to be a garage.",
      "segment": "07-square"
    },
    {
      "start": 72.68666666666667,
      "end": 74.15666666666667,
      "text": "I detour to the north-street garage.",
      "segment": "08-repair"
    },
    {
      "start": 74.66166666666668,
      "end": 75.71916666666667,
      "text": "For 40 scrap",
      "segment": "08-repair"
    },
    {
      "start": 75.88666666666667,
      "end": 76.65666666666667,
      "text": "and six seconds parked,",
      "segment": "08-repair"
    },
    {
      "start": 76.79916666666668,
      "end": 78.54416666666667,
      "text": "the RV is back to full durability.",
      "segment": "08-repair"
    },
    {
      "start": 79.02416666666667,
      "end": 81.25666666666666,
      "text": "You do not have to clear the entire map;",
      "segment": "08-repair"
    },
    {
      "start": 81.54916666666668,
      "end": 83.18166666666667,
      "text": "you can choose to leave at the northern camp.",
      "segment": "08-repair"
    },
    {
      "start": 84.45333333333333,
      "end": 85.94833333333334,
      "text": "I successfully evacuate.",
      "segment": "09-result"
    },
    {
      "start": 86.45333333333333,
      "end": 87.44833333333334,
      "text": "I searched two districts,",
      "segment": "09-result"
    },
    {
      "start": 87.62833333333334,
      "end": 88.96083333333333,
      "text": "defeated 12 zombies,",
      "segment": "09-result"
    },
    {
      "start": 89.11583333333334,
      "end": 90.73583333333333,
      "text": "and brought out 314 scrap.",
      "segment": "09-result"
    },
    {
      "start": 91.24083333333334,
      "end": 92.69833333333334,
      "text": "I have not searched all six districts.",
      "segment": "09-result"
    },
    {
      "start": 92.97833333333334,
      "end": 95.26083333333334,
      "text": "Next time, I will try a full scavenging route.",
      "segment": "09-result"
    },
    {
      "start": 96.52,
      "end": 99.565,
      "text": "RV mode is already playable on Bilibili Toy.",
      "segment": "10-close"
    },
    {
      "start": 100.0575,
      "end": 101.28999999999999,
      "text": "Would you upgrade the gun first",
      "segment": "10-close"
    },
    {
      "start": 101.5825,
      "end": 102.6775,
      "text": "or add armor?",
      "segment": "10-close"
    },
    {
      "start": 103.1825,
      "end": 105.3275,
      "text": "You can also visit the Treasure Box game voting page",
      "segment": "10-close"
    },
    {
      "start": 105.545,
      "end": 106.8025,
      "text": "and suggest what you want to play.",
      "segment": "10-close"
    }
  ],
  "time_scale": 1,
  "normal_rules": true,
  "original_capture": "capture/journey-02/capture.json",
  "result_screen_hold_only": true
}
