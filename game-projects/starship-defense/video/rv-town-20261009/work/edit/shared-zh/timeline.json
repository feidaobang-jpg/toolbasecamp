      "text": "This RV is heading into a zombie-infested town.",
      "segment": "01-hook"
    },
    {
      "start": 2.42,
      "end": 3.7025,
      "text": "Can I bring it back in one piece?",
      "segment": "01-hook"
    },
    {
      "start": 4.195,
      "end": 5.465000000000001,
      "text": "In Swarm Siege this time,",
