      "segDur": 14.014,
      "start": 11.206,
      "subs": [
        {
          "a": 0.30000000000000004,
          "b": 3.075,
          "t": "规则很直接：三百六十秒之内，"
        },
        {
          "a": 3.075,
          "b": 6.246428571428572,
          "t": "把人类基地的核心拆掉。对面是六个"
        },
        {
          "a": 6.246428571428572,
          "b": 9.417857142857143,
          "t": "守军、九座炮塔和建筑、两千五血量"
        },
        {
          "a": 9.417857142857143,
          "b": 12.589285714285714,
          "t": "的城门，后面还有两千血的基地核心"
        },
        {
          "a": 12.589285714285714,
          "b": 12.7875,
          "t": "。"
        }
      ],
      "text": "规则很直接：三百六十秒之内，把人类基地的核心拆掉。对面是六个守军、九座炮塔和建筑、两千五血量的城门，后面还有两千血的基地核心。"
    },
    {
